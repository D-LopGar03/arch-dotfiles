{
    "layer": "top",
    "position": "top",
    "margin-top": 0,
    "margin-left": 60,
    "margin-right": 60,
    "modules-right": [
        "custom/wayves",
        "memory",
        "cpu",
        "custom/launcher"
    ],
    "modules-center": [
        "hyprland/workspaces"
    ],
    "modules-left": [
        "clock",
        "battery",
        "network",
        "tray",
        "pulseaudio",
        "backlight",
        "custom/notification"
    ],
    "custom/launcher": {
        "format": "",
        "tooltip": false,
        "on-click": "/home/ay4t0/.config/scripts/./waypaper_change_wallpaper.sh"
    },
    "hyprland/workspaces": {
        "format": "{icon}",
        "on-click": "activate",
        "persistent-workspaces": {
            "1": [],
            "2": [],
            "3": [],
            "4": [],
            "5": []
        },
        "format-icons": {
            "1": "<span color='#ff0000'></span>",
            "2": "<span color='#ffa500'></span>",
            "3": "<span color='#00ffff'></span>",
            "4": "<span color='#ff69b4'></span>",
            "5": "<span color='#ff0000'></span>",
            "active": "<span color='#ffff00'>󰮯 </span>",
            "default": "<span color='#666666'> </span>",
        },
        "sort-by-number": true,
        "all-outputs": true
    },
    "battery": {
        "states": {
            "good": 95,
            "warning": 20,
            "critical": 10
        },
        "format": "{icon}   {capacity}%",
        "format-charging": "<span color='#ffeb3b'> </span> <span color='#ffeb3b'>{capacity}%</span>",
        "format-plugged": " <span color='#ff8000'>{capacity}</span>%",
        "format-alt": "<span color='#f1f1f1'>{time}</span> {icon}",
        "format-icons": [
            "<span color='#f7768e'> </span>",
            "<span color='#e0af68'> </span>",
            "<span color='#e0af68'> </span>",
            "<span color='#9ece6a'> </span>",
            "<span color='#9ece6a'> </span>"
        ]
    },
    "custom/wayves": {
        "format": "{}",
        "exec": "python ~/.config/scripts/wayves/wayves.py -o cava -i cava -a cava",
        "on-click": "playerctl previous",
        "on-scroll-up": "playerctl pause",
        "on-scroll-down": "playerctl play",
        "on-click-right": "playerctl next"
    },
    "custom/notification": {
        "tooltip": false,
        "format": "{icon}",
        "format-icons": {
            "notification": "󱅫",
            "none": "",
            "dnd-notification": " ",
            "dnd-none": "󰂛",
            "inhibited-notification": " ",
            "inhibited-none": "",
            "dnd-inhibited-notification": " ",
            "dnd-inhibited-none": " "
        },
        "return-type": "json",
        "exec-if": "which swaync-client",
        "exec": "swaync-client -swb",
        "on-click": "sleep 0.1 && swaync-client -t -sw",
        "on-click-right": "sleep 0.1 && swaync-client -d -sw",
        "escape": true
    },
    
    "backlight": {
    
    "device": "intel_backlight", // Opcional: especifica la GPU si no detecta el brillo autom\u00e1ticamente
    "format": "{icon} {percent}%",
    "format-icons": ["󰃞", "󰃟", "󰃠"], // Iconos de Nerd Fonts (baja, media, alta)
    "on-scroll-up": "brightnessctl set 10%+",
    "on-scroll-down": "brightnessctl set 10%-",
    "min-length": 6
      
  },

    "clock": {
        "format": "{:%H:%M}  ",
        "format-alt": "{:%A, %B %d, %Y (%R)} 󰸘 ",
        "tooltip-format": "<tt><small>{calendar}</small></tt>",
        "calendar": {
            "mode": "month",
            "mode-mon-col": 3,
            "weeks-pos": "right",
            "on-scroll": 1,
            "on-click-right": "mode",
            "format": {
                "months": "<span color='#ffead3'><b>{}</b></span>",
                "days": "<span color='#ecc6d9'><b>{}</b></span>",
                "weeks": "<span color='#99ffdd'><b>W{}</b></span>",
                "weekdays": "<span color='#ffcc66'><b>{}</b></span>",
                "today": "<span color='#ff6699'><b><u>{}</u></b></span>"
            }
        },
        "actions": {
            "on-click-right": "mode",
            "on-click-forward": "tz_up",
            "on-click-backward": "tz_down",
            "on-scroll-up": "shift_up",
            "on-scroll-down": "shift_down"
        }
    },
    "pulseaudio": {
        "format": "{icon}   {volume}% ",
        "format-bluetooth": "{volume}% {icon} {format_source}",
        "format-bluetooth-muted": " {icon} {format_source}",
        "format-muted": "󰂭 ",
        "format-source-muted": "",
        "format-icons": {
            "headphone": "",
            "hands-free": "",
            "headset": "",
            "phone": "",
            "portable": "",
            "car": "",
            "default": [
                "  ",
                "  ",
                "  "
            ]
        },
        "on-click": "pavucontrol",
        "on-click-right": "pactl set-sink-mute @DEFAULT_SINK@ toggle"
    },
    "network": {
        "format-wifi": "{icon}    {ipaddr}",
        "format-ethernet": "{ipaddr}/{cidr} ",
        "tooltip-format": "{ifname} via {gwaddr} ",
        "format-linked": "{ifname} (No IP) ",
        "format-disconnected": "󰤫",
        "format-alt": "{essid}",
        "format-icons": {
            "default": [
                "<span color='#fe3702'>󰤟 </span>",
                "<span color='#feaa02'>󰤢 </span>",
                "<span color='#93fe02'>󰤥 </span>",
                "<span color='#23ff00'>󰤨 </span>"
            ]
        }
    },
    "memory": {
        "interval": 5,
        "format": " {used} GiB",
        "max-length": 10
    },
    "cpu": {
        "interval": 5,
        "format": " {usage}%",
        "max-length": 10
    }
}
